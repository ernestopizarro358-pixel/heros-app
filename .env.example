# Dónde se guardan los datos:
#   local    → localStorage del navegador (por defecto, sin cuenta)
#   supabase → base de datos en la nube con login (necesita las dos variables de abajo)
NEXT_PUBLIC_DATA_BACKEND=local

# Supabase — Project Settings → API (la clave "publishable" es pública por diseño;
# la protección real son las políticas RLS de supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
